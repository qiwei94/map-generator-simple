# Copy to /etc/map-generator/studio.env, chmod 600, and replace every CHANGE_ME.
# Never commit the real file.
STUDIO_PORT=80
WORKER_MODE=1
WORKER_LEASE_SECONDS=90
WORKER_TOKEN=CHANGE_ME_RANDOM_32_BYTES

# Keep AUTH_REQUIRED=0 until HTTPS, DNS, and SMTP have been verified.
AUTH_REQUIRED=0
AUTH_SECRET=CHANGE_ME_RANDOM_32_BYTES
AUTH_COOKIE_SECURE=1
STUDIO_DB_PATH=/root/map-generator-simple/data/studio.db
DEFAULT_MONTHLY_QUOTA=20
ADMIN_EMAILS=owner@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USERNAME=owner@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=owner@example.com

MAP_GEN_CACHE_DIR=/root/map-cache
PYTHONIOENCODING=utf-8

